# ⚠️ 이 파일은 "템플릿"입니다. git에 올라갑니다. 실제 키를 여기 적지 마세요.
#    실제 키는 .env 에 넣으세요 (.gitignore에 등록돼 있어 커밋되지 않습니다).
#    복사: copy .env.example .env

# ---------------------------------------------------------------
# 1) DB 연결 — Supabase PostgreSQL
#    ⚠️ 프로젝트 URL(https://xxxx.supabase.co)이 아니라 Postgres 연결
#       문자열이 필요합니다. 대시보드 상단 [Connect] > Session pooler > URI
#       * postgres:// 로 시작하면 postgresql:// 로 바꿀 것
#       * 비밀번호 특수문자는 URL 인코딩 (@ → %40, ^ → %5E)
#       * db.<ref>.supabase.co 직접 연결은 IPv6 전용 → 국내망에서 대부분 실패
#    인터넷이 막힌 상황의 오프라인 폴백으로만 SQLite 줄을 쓰세요.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<프로젝트ref>:<비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# DATABASE_URL=sqlite:///./jeju_cagong.db

# ---------------------------------------------------------------
# 2) Supabase Auth — 구글/카카오 소셜 로그인
#    백엔드는 로그인을 처리하지 않고 Supabase가 발급한 JWT 서명만 검증합니다.
#    SUPABASE_ANON_KEY: 대시보드 > Project Settings > API Keys > anon/public
#      → 공개키라 프론트에 그대로 노출됩니다. 방어선은 RLS입니다.
#    SUPABASE_JWT_SECRET: 2025-10 이후 생성된 프로젝트는 비워둘 것
#      (비대칭키 ES256 → JWKS 공개키로 자동 검증)
#    AUTH_REQUIRED=false: 프론트 로그인 붙기 전 개발용. 발표 전 true 로!
# ---------------------------------------------------------------
SUPABASE_URL=https://<프로젝트ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
AUTH_REQUIRED=true

# ---------------------------------------------------------------
# 3) 카카오 REST API 키
#    developers.kakao.com > 내 애플리케이션 > 앱 키 > REST API 키
#    (JavaScript 키 아님! 프론트팀이 쓰는 게 JavaScript 키)
#    카페 목록 수집 + 자동차 길찾기에 공통으로 사용
# ---------------------------------------------------------------
KAKAO_REST_KEY=

# 카카오맵 JavaScript 키 (지도 렌더링용 — 브라우저에서 사용)
#   developers.kakao.com > 내 애플리케이션 > 앱 키 > JavaScript 키
#   ⚠️ 위의 REST API 키와 다른 값입니다. 서로 바꿔 쓰면 동작하지 않습니다.
#   ⚠️ 플랫폼 > Web > 사이트 도메인에 http://127.0.0.1:8000 을 등록해야 합니다.
#      (등록 안 하면 지도가 회색으로만 뜨고 콘솔에 401이 찍힙니다)
#   이 키는 프론트 코드에 노출됩니다. 도메인 제한이 방어선입니다.
KAKAO_JS_KEY=

# ---------------------------------------------------------------
# 4) 비짓제주(제주관광공사) 관광정보 Open API 키
#    https://www.visitjeju.net/kr/visitjejuapi 에서 이메일로 신청
#    → 담당자 수동 승인 후 메일 발송 (즉시 발급 아님, 반나절~하루 소요 가능)
#    키를 기다리는 동안에는 data/hours_override.csv 로 대체
# ---------------------------------------------------------------
VISITJEJU_API_KEY=

# ---------------------------------------------------------------
# 5) 이동시간 계산
#    USE_KAKAO_NAVI=false → 길찾기 API 호출 없이 직선거리 추정만 (쿼터 절약)
#    도보 길찾기는 카카오 제휴 계약 전용이라 아래 추정식으로 대체
# ---------------------------------------------------------------
USE_KAKAO_NAVI=true
WALK_DETOUR_FACTOR=1.3
WALK_SPEED_KMH=4.0

# 6) 프론트 개발서버 주소 (콤마로 여러개, * 는 전체 허용)
CORS_ORIGINS=*

# ── 네이버 CLOVA OCR (영수증 인증) ────────────────────────────────────
# console.ncloud.com > AI Services > CLOVA OCR
#   1) 도메인 생성 (모델: Document OCR / 영수증)
#   2) APIGW 연동까지 완료해야 호출됩니다
#   3) 아래 두 값을 콘솔에서 그대로 복사 — URL 은 도메인마다 다릅니다
# ⚠️ 둘 다 서버 전용. 프론트에 넘기면 남이 우리 쿼터로 OCR 을 돌립니다.
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=
